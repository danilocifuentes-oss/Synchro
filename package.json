{
  "name": "el-cronista-de-las-sombras",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "SPA SchreckNet — mesa inspirada en V:tM V5 (fan work, no oficial)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "raster:avatars": "node tools/rasterize-avatars.js",
    "assets:raster": "node tools/rasterize-assets.js",
    "svgo:icons": "svgo -f public/icons -r --config=svgo.config.js",
    "svgo:avatars": "svgo -f public/avatars -r --config=svgo.config.js",
    "svgo:textures": "svgo -f public/textures -r --config=svgo.config.js",
    "svgo:all": "npm run svgo:icons && npm run svgo:avatars && npm run svgo:textures",
    "svgr:gen": "node tools/generate-svgr.js",
    "sprite:gen": "node tools/generate-sprite-svg.js && node tools/generate-sprite-css.js",
    "assets:build": "npm run svgo:all && npm run svgr:gen && npm run assets:raster && npm run sprite:gen",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "solo:narrative-digest": "tsx scripts/exportSoloNarrativeDigest.ts",
    "solo:export-edicion": "tsx scripts/exportSoloChronicleEditSheet.ts",
    "solo:validate": "tsx scripts/validateSoloChronicle.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/generative-ai": "^0.24.1",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "openai": "^6.35.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "glob": "^13.0.6",
    "sharp": "^0.34.5",
    "svg-sprite-cli": "^1.2.2",
    "svgo": "^4.0.1",
    "svgstore": "^3.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^6.4.2"
  }
}
