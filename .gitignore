# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Cursor / IDE local (no versionar)
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# orquestación Nexo en disco local (solo si NEXO_ORCH_DISK=1)
/.data/

# Volcado narrativo reproducible (`npm run solo:narrative-digest`)
/content/solo-campaign/

# Proyecto local separado (no mezclar con El Cronista)
/app/punetes/
/public/punetes/
/share/punetes/
/share/punetes-web.zip
